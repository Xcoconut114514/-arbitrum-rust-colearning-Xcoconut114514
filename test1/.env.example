# Arbitrum Sepolia 公共 RPC（官方）
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# 仅用于测试网的钱包私钥（不要提交到 Git，.gitignore 已忽略 .env）
# 形式示例：0x0123...abcd
PRIVATE_KEY=

# 可选：部署后的 HelloWeb3 合约地址（0x...），填了就会调用 hello_web3()
HELLO_

# 可选：Counter 合约地址（0x...），填了就会读取 number()
COUNTER_CONTRACT=

# 可选：设置为 1 会发送 increment() 交易（需要 PRIVATE_KEY 且账户有测试 ETH）
DO_INCREMENT=0

# 可选：查询余额的地址（0x...）。不填则在 PRIVATE_KEY 存在时查询当前钱包地址。
BALANCE_ADDRESS=0x3F2f84d6AEE437f1724E36D00554Bf435938EAA5

# ===== 转账脚本（test1/src/bin/transfer.rs） =====
# 可选：收款地址；不填则默认转到 0xa7413b9E079127ce7F202c4b132df18204F52436
TO_ADDRESS=

# 可选：转账金额（ETH，最多 18 位小数），默认 0.0001
AMOUNT_ETH=0.0001

# 可选：设置为 1 才会真正广播交易（否则只估算 gas/费用）
DO_SEND=0
